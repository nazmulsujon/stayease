# ─────────────────────────────────────────────────────────────
# StayEase environment variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it is ignored by Git.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string.
# Must point to a REPLICA SET, because booking uses multi-document
# transactions for double-booking protection. MongoDB Atlas (free M0
# cluster) is a replica set by default.
#   Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#   Local example: mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_URI=

# Database name inside the cluster.
MONGODB_DB_NAME=stayease

# Secret used to sign login session tokens (JWT). Minimum 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public site URL (no trailing slash). Used for canonical links, Open Graph
# images, sitemap.xml and robots.txt. Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How long a login session lasts (e.g. 7d, 12h).
JWT_EXPIRES_IN=7d

# ── Administrator account (created by `npm run seed:admin`) ──
# Admins cannot register publicly. Use a strong password: at least
# 8 characters with a letter and a number. Never commit real values.
ADMIN_NAME=Hotel Admin
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# ── Demo data (created by `npm run seed:demo`) ──
# Password shared by the demo customer accounts (…@demo.stayease.test).
DEMO_CUSTOMER_PASSWORD=
